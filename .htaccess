RewriteEngine On

# Serve extensionless URLs from directory index.html (fixes soft 404)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^books/([a-z0-9-]+)/?$ books/$1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^authors/([a-z0-9-]+)/?$ authors/$1/index.html [L]

# Legacy .html URLs -> clean extensionless URLs (fixes redirect errors)
RewriteRule ^books/(.+)\.html$ /books/$1 [R=301,L]
RewriteRule ^authors/(.+)\.html$ /authors/$1 [R=301,L]

ErrorDocument 404 /404.html
