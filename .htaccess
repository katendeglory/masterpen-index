RewriteEngine On

# Serve extensionless URLs from directory index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^books/([a-z0-9-]+)/?$ books/$1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^authors/([a-z0-9-]+)/?$ authors/$1/index.html [L]

# .html URLs are served as flat files (no redirect — canonical handles dedup)

ErrorDocument 404 /404.html
